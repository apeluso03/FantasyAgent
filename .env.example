# Sleeper league to sync (no auth needed for Sleeper's public API)
SLEEPER_LEAGUE_ID=1312255990598483968

# Local cache DB. SQLite by default for the CLI/GUIs and local dev; switch to
# Postgres for any deployment with an ephemeral filesystem (CLAUDE.md 7.2) --
# e.g. DATABASE_URL=postgresql+psycopg://user:password@host:5432/fantasy_agent
# (note the +psycopg, not the old +psycopg2, dialect).
DATABASE_URL=sqlite:///data/fantasy_agent.db

# How long cached players/nfl data is considered fresh before re-pulling
PLAYERS_CACHE_TTL_HOURS=24

# FantasyPros rankings page to scrape (superflex/dynasty overall carries pos_rank too)
FANTASYPROS_RANKING_PAGE=dynasty-superflex
RANKINGS_CACHE_TTL_HOURS=6

# Your Sleeper user_id, used to default keeper/trade tools to your roster
SLEEPER_OWNER_USER_ID=1038585800163909632

# Keeper cost = max(1, round_drafted - KEEPER_ROUND_PENALTY)
KEEPER_ROUND_PENALTY=2

# Required only for `fantasy-agent ask` (OpenAI Responses API tool-calling agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Web backend only (backend/app) -- unused by the CLI and Tkinter GUIs ---

# Comma-separated frontend origins allowed to call the API (CORS). The web
# backend already requires a signed-in account on every route but /api/health
# and /api/auth/* (CLAUDE.md 5.10), so this is about browser CORS, not auth.
CORS_ORIGINS=http://localhost:5173

# Optional second gate in front of /api/agent/* and /api/sync/* specifically,
# since those are the two routes that cost real money (OpenAI calls, Sleeper/
# FantasyPros scraping) per request. Leave unset locally; set it before
# deploying anywhere public (CLAUDE.md 5.7, 8 Phase 5).
DEMO_ACCESS_CODE=
